# Database Configuration
DATABASE_URL=postgresql://raguser:ragpass@postgres:5432/ragdb

# RabbitMQ Configuration
RABBITMQ_URL=amqp://raguser:ragpass@rabbitmq:5672

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# API Security
API_KEY=your-super-secret-api-key-here-change-in-production
# Optional JSON object mapping tenant IDs to API keys, for example: {"acme":"key-a","globex":"key-b"}
TENANT_API_KEYS=

# Reliable delivery (publisher polls independently of the API)
OUTBOX_POLL_SECONDS=1
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_BACKOFF_SECONDS=60
MESSAGE_RETRY_DELAYS_MS=1000,5000,30000

# Token-aware document processing (CHUNK_SIZE/CHUNK_OVERLAP are legacy character settings)
CHUNK_TARGET_TOKENS=96
CHUNK_OVERLAP_TOKENS=12
EMBEDDING_BATCH_SIZE=32
OCR_ENABLED=false
OCR_LANGUAGES=por+eng

# Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# Worker Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Search Settings
SEARCH_DEFAULT_TOP_K=10
SEARCH_MAX_TOP_K=100
RRF_K=60

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO

# Security and operations (OIDC optional; RS256 only, HTTPS issuer/JWKS)
MAX_UPLOAD_BYTES=20971520
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=tenant_id
EXTRACTION_TIMEOUT_SECONDS=120
# 0 disables automatic document expiry. Schedule python -m api.retention explicitly.
RETENTION_DAYS=0
OUTBOX_RETENTION_DAYS=7
