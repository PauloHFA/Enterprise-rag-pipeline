# ============================================
# ENTERPRISE RAG - FREE TIER ENVIRONMENT
# Copie para .env e preencha os valores marcados com CHANGE_ME
# ============================================

# ----------------------------------------
# DATABASE (PostgreSQL + pgvector)
# ----------------------------------------
POSTGRES_USER=raguser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=ragdb

# ----------------------------------------
# RABBITMQ
# ----------------------------------------
RABBITMQ_USER=raguser
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RABBITMQ_PASSWORD

# ----------------------------------------
# MINIO (S3-compatible)
# ----------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD

# ----------------------------------------
# API SECURITY
# ----------------------------------------
# Gere com: openssl rand -hex 32
API_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ----------------------------------------
# EMBEDDING MODEL (Local - sem custo)
# ----------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# ----------------------------------------
# WORKER SETTINGS
# ----------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ----------------------------------------
# SEARCH SETTINGS
# ----------------------------------------
SEARCH_DEFAULT_TOP_K=10
SEARCH_MAX_TOP_K=50
RRF_K=60

# ----------------------------------------
# RATE LIMITING
# ----------------------------------------
RATE_LIMIT_PER_MINUTE=60

# ----------------------------------------
# LOGGING
# ----------------------------------------
LOG_LEVEL=INFO

# ----------------------------------------
# GRAFANA
# ----------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ----------------------------------------
# OPTIONAL: CLOUDFLARE TUNNEL (se usar)
# ----------------------------------------
# CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_IF_USING_CLOUDFLARE_TUNNEL